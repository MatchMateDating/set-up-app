# Backend Environment Variables Template
# Copy this file to .env in the backend directory and fill in your actual values
# The .env file is gitignored and won't be committed to the repository
#
# To create your .env file:
#   cp env.template .env
#   # Then edit .env with your actual values

# ============================================================================
# Flask Configuration
# ============================================================================
FLASK_APP=app:create_app
FLASK_ENV=development
PORT=5000

# ============================================================================
# Application Secrets (Optional for local dev, REQUIRED for production)
# ============================================================================
# For local development: These are optional - defaults will be used if not set
# For production: MUST set strong random keys for security
# Generate strong random keys:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# SECRET_KEY=dev-secret-key-change-in-production
# JWT_SECRET_KEY=super-secret-key-change-in-production
# Session length when user does NOT check "remember me" (default: 24 hours). Optional overrides:
# JWT_ACCESS_TOKEN_EXPIRES_HOURS=24
# JWT_ACCESS_TOKEN_EXPIRES_DAYS=1

# ============================================================================
# Database Configuration
# ============================================================================
# If DATABASE_URL is set in your OS (e.g. Railway CLI) but you want SQLite locally:
# USE_LOCAL_SQLITE=true
#
# For local development, leave DATABASE_URL and DB_* unset to use SQLite (recommended)
# Only uncomment these if you have PostgreSQL running locally
# DB_USERNAME=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=railway

# ============================================================================
# Email Service Configuration
# ============================================================================
# Primary: Resend (currently used for all emails)
RESEND_API_KEY=your_resend_api_key

# Optional: AWS SES (alternative email service, not currently used)
# SES_SNS_KEY=your_aws_access_key_id_from_grainygains_user
# SES_SNS_SECRET=your_aws_secret_access_key_from_grainygains_user
# SES_SENDER_EMAIL=your_verified_sender_email
# AWS_REGION=us-east-2
# AWS_PROFILE=grainygains

# ============================================================================
# Cloudflare R2 Storage Configuration
# ============================================================================
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com

# CDN Configuration
# Your custom domain configured in Cloudflare R2 to serve images
CDN_BASE_URL=https://cdn.yourdomain.com/images

# Storage Environment Prefix
# Set to 'dev' for development, 'prod' for production, or leave empty
STORAGE_ENV_PREFIX=dev

# ============================================================================
# CORS Configuration
# ============================================================================
CORS_ORIGINS=*

# ============================================================================
# Test Mode Configuration
# ============================================================================
# Enable test mode to skip email verification for test email addresses
# Only use in development/testing, NOT in production
TEST_MODE_ENABLED=false
TEST_EMAIL_DOMAINS=@test.com,@example.com,@test.local

# ============================================================================
# Twilio (SMS verification — signup with phone number)
# ============================================================================
# Used by /auth/register when signing up with phone_number: sends the code from
# TWILIO_PHONE_NUMBER via Twilio. Must be a Twilio SMS-capable number you own.
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+15551234567

# ============================================================================
# Other Services
# ============================================================================
# OpenAI (for AI embeddings)
OPENAI_API_KEY=your_openai_api_key

# Frontend URL (for password reset links, etc.)
FRONTEND_URL=http://localhost:3000

# API Base URL (for email verification links)
API_BASE_URL=http://localhost:5000

# Signup URL (for referral links)
SIGNUP_URL=test_url

# ============================================================================
# Test push API (POST /notifications/test_push)
# ============================================================================
# In production, test_push returns 404 unless you set:
# ALLOW_TEST_PUSH=true

# ============================================================================
# Native push (APNs + FCM) — optional; omit to use Expo relay only
# ============================================================================
# APNs: Auth Key (.p8) from Apple Developer; bundle id must match the iOS app
# Use APNS_KEY_PATH (file) or APNS_KEY_CONTENT (PEM string, e.g. multiline secret on Railway)
# APNS_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
# APNS_KEY_CONTENT=
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=XXXXXXXXXX
# APNS_TOPIC=com.matchmate.matchmatedating
# APNS_USE_SANDBOX=true
#
# Firebase Admin (Android FCM): service account JSON from Firebase Console → Service accounts → Generate key
# Prefer setting this in backend/.env so Flask always sees it (Windows user env may not reach the IDE process).
# Name must be FIREBASE_CREDENTIALS_PATH (with an "s" in CREDENTIALS), not FIREBASE_CREDENTIAL_PATH
# FIREBASE_CREDENTIALS_PATH=C:\path\to\firebase-adminsdk-xxxxx.json
# FIREBASE_CREDENTIALS_JSON=

# ============================================================================
# Web Push (VAPID) — optional; required to deliver browser / PWA notifications
# ============================================================================
# Generate a key pair (do not commit the private key):
#   python -c "from cryptography.hazmat.primitives.asymmetric import ec; from cryptography.hazmat.primitives import serialization; import base64; k=ec.generate_private_key(ec.SECP256R1()); priv=k.private_numbers().private_value.to_bytes(32,'big'); pub=k.public_key().public_bytes(serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint); b=lambda d: base64.urlsafe_b64encode(d).rstrip(b'=').decode(); print('VAPID_PUBLIC_KEY='+b(pub)); print('VAPID_PRIVATE_KEY='+b(priv))"
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@matchmatedating.com
#
# Frontend (optional): set the same public key as REACT_APP_VAPID_PUBLIC_KEY in frontend-app/.env.local
# Or let the web app fetch GET /notifications/vapid_public_key after deploy.
